{
    "realm":  "identity-access",
    "enabled":  true,
    "sslRequired":  "none",
    "registrationAllowed":  false,
    "resetPasswordAllowed":  false,
    "clients":  [
                    {
                        "clientId":  "identity-access-app",
                        "name":  "Identity Access Lab local demo",
                        "enabled":  true,
                        "protocol":  "openid-connect",
                        "publicClient":  false,
                        "secret":  "${OIDC_CLIENT_SECRET}",
                        "standardFlowEnabled":  true,
                        "directAccessGrantsEnabled":  true,
                        "serviceAccountsEnabled":  false,
                        "protocolMappers":  [
                                                {
                                                    "name":  "lab_role",
                                                    "protocol":  "openid-connect",
                                                    "protocolMapper":  "oidc-usermodel-attribute-mapper",
                                                    "consentRequired":  false,
                                                    "config":  {
                                                                   "user.attribute":  "lab_role",
                                                                   "claim.name":  "lab_role",
                                                                   "jsonType.label":  "String",
                                                                   "id.token.claim":  "true",
                                                                   "access.token.claim":  "true",
                                                                   "userinfo.token.claim":  "true"
                                                               }
                                                }
                                            ],
                        "redirectUris":  [
                                             "http://localhost:8000/auth/callback",
                                             "http://192.168.1.172:8000/*",
                                             "http://localhost:8000/*",
                                             "http://192.168.*",
                                             "http://10.*",
                                             "http://172.16.*",
                                             "http://172.17.*",
                                             "http://172.18.*",
                                             "http://172.19.*",
                                             "http://172.20.*",
                                             "http://172.21.*",
                                             "http://172.22.*",
                                             "http://172.23.*",
                                             "http://172.24.*",
                                             "http://172.25.*",
                                             "http://172.26.*",
                                             "http://172.27.*",
                                             "http://172.28.*",
                                             "http://172.29.*",
                                             "http://172.30.*",
                                             "http://172.31.*"
                                         ],
                        "webOrigins":  [
                                           "+"
                                       ]
                    }
                ],
